{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",

      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform version *)",
      "Bash(terraform init -backend=false *)",
      "Bash(terraform -chdir=terraform fmt *)",
      "Bash(terraform -chdir=terraform validate *)",
      "Bash(terraform -chdir=terraform init -backend=false *)",

      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(helm version *)",
      "Bash(helm list *)",
      "Bash(helm status *)",
      "Bash(helm history *)",
      "Bash(helm get *)",
      "Bash(helm show *)",

      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl version *)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl config current-context *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(kubectl port-forward *)",

      "Bash(gcloud container clusters list *)",
      "Bash(gcloud compute instances list *)",
      "Bash(gcloud compute disks list *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud auth list *)",

      "Bash(make help *)",
      "Bash(make setup *)",
      "Bash(make check *)",
      "Bash(make test *)",
      "Bash(make lint *)",
      "Bash(make fmt *)",
      "Bash(make helm-check *)",
      "Bash(make tf-check *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(kubectl exec *)",
      "Bash(terraform plan *)",
      "Bash(terraform -chdir=* plan *)"
    ],
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform taint *)",
      "Bash(terraform untaint *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform state rm *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state push *)",
      "Bash(terraform -chdir=* apply *)",
      "Bash(terraform -chdir=* destroy *)",
      "Bash(terraform -chdir=* import *)",
      "Bash(terraform -chdir=* force-unlock *)",
      "Bash(terraform -chdir=* state *)",

      "Bash(gcloud * create *)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * resize *)",
      "Bash(gcloud * update *)",

      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl autoscale *)",
      "Bash(kubectl set *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl taint *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",

      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm delete *)",
      "Bash(helm rollback *)",

      "Bash(gh workflow enable *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh repo delete *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",

      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/kubeconfig*)",
      "Read(**/*credentials*.json)",
      "Read(**/*service-account*.json)"
    ]
  }
}
