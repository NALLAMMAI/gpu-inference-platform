{
  "title": "InstructCoder benchmark: vLLM direct vs gateway",
  "uid": "instructcoder-benchmark",
  "tags": [
    "benchmark",
    "instructcoder"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "run_id",
        "type": "query",
        "label": "Run",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(instructcoder_succeeded, run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(instructcoder_succeeded, run_id)",
        "refresh": 2,
        "sort": 2,
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Results of one run (client-side, from load_test.py via the Pushgateway)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "All levels, vLLM direct vs gateway",
      "description": "One row per target and concurrency level. 'vllm' was measured next to vLLM (localhost); 'gateway' went through the gateway Service. Same requests for both.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "instructcoder_output_tokens_per_s{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "instructcoder_requests_per_s{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "instructcoder_ttft_ms_p50{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "instructcoder_ttft_ms_p95{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "instructcoder_tpot_ms_mean{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "instructcoder_latency_s_p95{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "instructcoder_failed{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "instructcoder_finish_length{run_id=\"$run_id\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "run_id": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "endpoint": true,
              "container": true
            },
            "indexByName": {
              "target": 0,
              "concurrency": 1
            },
            "renameByName": {
              "target": "Target",
              "concurrency": "Concurrency",
              "Value #A": "Output tok/s",
              "Value #B": "Requests/s",
              "Value #C": "TTFT p50 (ms)",
              "Value #D": "TTFT p95 (ms)",
              "Value #E": "TPOT mean (ms)",
              "Value #F": "Latency p95 (s)",
              "Value #G": "Failed",
              "Value #H": "Cut off at max_tokens"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Concurrency",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Concurrency"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Output tokens per second",
      "description": "Total generated tokens per second across all requests at each level.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "instructcoder_output_tokens_per_s{run_id=\"$run_id\"}",
          "legendFormat": "{{target}} c={{concurrency}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "TTFT p50 (ms)",
      "description": "Median time from sending a request to its first generated text, measured by the client.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "instructcoder_ttft_ms_p50{run_id=\"$run_id\"}",
          "legendFormat": "{{target}} c={{concurrency}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Gateway cost: TTFT p50, gateway minus vLLM (ms)",
      "description": "How much later the first token arrives through the gateway than straight from vLLM. Single run: small differences are noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "instructcoder_ttft_ms_p50{run_id=\"$run_id\",target=\"gateway\"} - ignoring(target) instructcoder_ttft_ms_p50{run_id=\"$run_id\",target=\"vllm\"}",
          "legendFormat": "c={{concurrency}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Live during the run (server-side, scraped by Prometheus; set the time range to the run)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "vLLM requests running and waiting",
      "description": "Waiting > 0 means vLLM has queued requests it cannot fit into the current batch.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "vllm:num_requests_running{job=\"learning-vllm\"}",
          "legendFormat": "running",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "vllm:num_requests_waiting{job=\"learning-vllm\"}",
          "legendFormat": "waiting",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "KV cache usage (%)",
      "description": "Share of vLLM's KV cache in use. Near 100% means the cache, not compute, limits concurrency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "vllm:kv_cache_usage_perc{job=\"learning-vllm\"} * 100",
          "legendFormat": "KV cache",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Prefix cache hit rate (%)",
      "description": "Share of prompt tokens served from vLLM's prefix cache. load_test.py salts each level, so this should stay low (only the shared system prompt within a level is reused).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "100 * rate(vllm:prefix_cache_hits_total{job=\"learning-vllm\"}[1m]) / rate(vllm:prefix_cache_queries_total{job=\"learning-vllm\"}[1m])",
          "legendFormat": "hit rate",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Server-side TTFT p95 (s)",
      "description": "vLLM's own time to first token, without any network hop. Compare with the client-side numbers above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"learning-vllm\"}[1m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU utilization (%)",
      "description": "DCGM: share of time the L4 was busy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL{job=\"dcgm-exporter\"}",
          "legendFormat": "L4",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Gateway CPU (cores) and throttling",
      "description": "The gateway container is limited to 0.5 CPU. Throttled > 0 means that limit slowed it down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\",container=\"fastapi\"}[1m]))",
          "legendFormat": "CPU used (cores)",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"default\",container=\"fastapi\"}[1m])) / sum(rate(container_cpu_cfs_periods_total{namespace=\"default\",container=\"fastapi\"}[1m]))",
          "legendFormat": "share of periods throttled",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
